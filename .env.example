# Kopyala: cp .env.example .env  (.env dosyasını asla GitHub'a yükleme)
#
# ---- Zorunlu (üretim) ----
DATABASE_URL=postgresql://postgres:SIFRE@db.PROJE.supabase.co:5432/postgres
SUPABASE_URL=https://PROJE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_anahtari
SESSION_SECRET=en-az-32-karakterlik-rastgele-metin
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=en-az-16-karakterlik-guclu-parola

# ---- Yapay zekâ (Gemini) ----
# GEMINI_API_KEY yalnızca sunucu ortamında tutulur; frontend'e asla gönderilmez.
# GEMINI_API_KEY=
# AI_DAILY_LIMIT=30             # kullanıcı başına günlük soru tavanı
# AI_GLOBAL_DAILY=400           # okul başına günlük toplam soru tavanı
# AI_MONTHLY_LIMIT_USER=300     # kullanıcı başına AYLIK sert tavan (fatura kalkanı)
# AI_MONTHLY_LIMIT=5000         # okul başına AYLIK sert tavan (fatura kalkanı)
# AI_MAX_OUTPUT_TOKENS=900      # tek yanıt çıktı tavanı
# QUIZ_MAX_OUTPUT_TOKENS=3500   # sınav taslağı çıktı tavanı
# AI_DISABLED=1                 # acil kill-switch (1 = asistanı anında kapat)

# ---- Oran sınırları (isteğe bağlı, sıkılaştırmak için) ----
# IP_RATE_PER_MIN=1200          # bir IP'nin toplam dakikalık isteği
# API_RATE_PER_MIN=300          # oturumlu kullanıcı dakikalık API isteği
# WRITE_RATE_PER_MIN=60         # yazma (POST/PUT/PATCH/DELETE) dakikalık
# ANON_RATE_PER_MIN=30          # oturumsuz IP dakikalık
# ANON_RATE_PER_DAY=3000        # oturumsuz IP gündelik
# STATIC_RATE_PER_MIN=600       # statik varlık dakikalık
# AUTH_RATE_PER_MIN=5           # login/setup/reset IP dakikalık
# AUTH_RATE_PER_DAY=100         # login/setup/reset IP gündelik
# MAIL_RATE_PER_MIN=2           # şifre sıfırlama maili IP dakikalık
# MAIL_RATE_PER_DAY=20          # şifre sıfırlama maili IP gündelik
# PUBLIC_RATE_PER_MIN=30        # /api/public/* IP dakikalık
# FEED_RATE_PER_MIN=60          # /api/calendar/feed IP dakikalık
